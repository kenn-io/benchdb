    "check:docs-screenshots": "tsc --noEmit -p docs-screenshots/tsconfig.json",
    "codegen": "orval"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "github:kenn-io/kit-ui#fb75ee9568f73475eb3f14393b83f8b6e87f29c3",
    "@lucide/svelte": "1.64.0",
    "uplot": "1.6.32",
    "axios": "1.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.9",
    "jsdom": "29.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "orval": "8.45.0"
  }
