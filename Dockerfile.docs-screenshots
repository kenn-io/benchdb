ARG BUN_VERSION=1.4.4

FROM docker.io/oven/bun:${BUN_VERSION} AS bun

FROM node:24.22.1-bookworm-slim AS node

FROM ubuntu:24.04

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node /usr/local/bin/node /usr/local/bin/node

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /workspace

COPY web/package.json web/bun.lock ./web/
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    cd web && bun install --frozen-lockfile && \
    bun x playwright install --with-deps chromium && \
    chmod -R a+rX /ms-playwright && \
    rm -rf /var/lib/apt/lists/*

COPY web/docs-screenshots ./web/docs-screenshots
RUN chmod -R a+rX /workspace/web && \
    mkdir -p /workspace/web/test-results && \
    chmod -R a+rwX /workspace/web/test-results

WORKDIR /workspace/web

CMD ["bun", "run", "docs:screenshots"]
