      "css": ".ds-btn{min-height:28px;display:inline-flex;align-items:center;padding:0 9px;border:1px solid var(--c-border-muted);border-radius:4px;background:var(--c-surface);color:var(--c-text-muted);font:inherit;font-size:13px;font-weight:650;cursor:pointer;transition:background-color 120ms ease,border-color 120ms ease,color 120ms ease}.ds-btn:hover{border-color:var(--c-accent);color:var(--c-accent);background:var(--c-accent-soft)}.ds-btn:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action on a page.",
      "html": "<button class=\"ds-btn-primary\">Compare</button>",
      "css": ".ds-btn-primary{min-height:28px;display:inline-flex;align-items:center;padding:0 9px;border:1px solid var(--c-accent);border-radius:4px;background:var(--c-accent);color:var(--c-on-accent);font:inherit;font-size:13px;font-weight:650;cursor:pointer}.ds-btn-primary:hover{background:var(--c-accent-strong);border-color:var(--c-accent-strong)}.ds-btn-primary:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Toggle Button",
      "kind": "button",
      "refersTo": "button-pressed",
      "description": "Filter toggles such as All / Outliers / Steps.",
      "html": "<span class=\"ds-toggles\"><button class=\"ds-toggle\" aria-pressed=\"true\">All 56</button><button class=\"ds-toggle\" aria-pressed=\"false\">Steps 3</button></span>",
      "css": ".ds-toggles{display:inline-flex;gap:6px}.ds-toggle{min-height:28px;padding:0 9px;border:1px solid var(--c-border-muted);border-radius:4px;background:var(--c-surface);color:var(--c-text-muted);font:inherit;font-size:13px;font-weight:650;cursor:pointer}.ds-toggle[aria-pressed=true]{border-color:color-mix(in srgb,var(--c-accent) 30%,var(--c-border));background:var(--c-accent-soft);color:var(--c-accent-strong)}.ds-toggle:hover{border-color:var(--c-accent);color:var(--c-accent)}.ds-toggle:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive actions only.",
      "html": "<button class=\"ds-btn-danger\">Delete result</button>",
      "css": ".ds-btn-danger{min-height:28px;padding:0 9px;border:1px solid color-mix(in srgb,var(--c-error) 30%,var(--c-border));border-radius:4px;background:var(--c-surface);color:var(--c-error);font:inherit;font-size:13px;font-weight:650;cursor:pointer}.ds-btn-danger:hover{background:var(--c-error-soft)}.ds-btn-danger:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text field with focus outline.",
      "html": "<input class=\"ds-input\" type=\"search\" placeholder=\"Search benchmarks\" aria-label=\"Search benchmarks\">",
      "css": ".ds-input{min-height:30px;padding:0 9px;border:1px solid var(--c-border);border-radius:4px;background:var(--c-surface);color:var(--c-text);font:inherit;font-size:13px}.ds-input:focus{border-color:var(--c-accent)}.ds-input:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-regressed",
      "description": "Verdict pills; the word always accompanies the color.",
      "html": "<span class=\"ds-badges\"><span class=\"ds-badge ds-regressed\">regressed</span><span class=\"ds-badge ds-improved\">improved</span><span class=\"ds-badge ds-caution\">missing baseline</span><span class=\"ds-badge ds-stable\">stable</span></span>",
      "css": ".ds-badges{display:inline-flex;gap:6px;flex-wrap:wrap}.ds-badge{min-height:22px;display:inline-flex;align-items:center;padding:0 7px;border:1px solid var(--c-border-muted);border-radius:999px;font-size:0.7rem;font-weight:750;line-height:1}.ds-regressed{background:var(--c-error-soft);color:var(--c-error);border-color:color-mix(in srgb,var(--c-error) 24%,var(--c-border))}.ds-improved{background:var(--c-success-soft);color:var(--c-success);border-color:color-mix(in srgb,var(--c-success) 22%,var(--c-border))}.ds-caution{background:var(--c-warning-soft);color:var(--c-warn-text);border-color:color-mix(in srgb,var(--c-warning) 24%,var(--c-border))}.ds-stable{background:var(--c-stable-soft);color:var(--c-stable)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white panel on the grey ground.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Series trend</h2><p class=\"ds-panel-body\">28 results</p></section>",
      "css": ".ds-panel{padding:12px;background:var(--c-surface);border:1px solid var(--c-border-muted);border-radius:6px;box-shadow:var(--shadow-panel)}.ds-panel-title{margin:0 0 8px;font-size:0.95rem}.ds-panel-body{margin:0;color:var(--c-text-muted);font-size:13px}"
    },
    {
      "name": "Data Table",
      "kind": "custom",
      "refersTo": "table-header",
      "description": "Inset header band, hairline rows, monospace numbers.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Benchmark</th><th>Change</th></tr></thead><tbody><tr><td>parse-small-cpu-time</td><td class=\"ds-num\">+26.3% worse</td></tr><tr><td>export-large-peak-rss</td><td class=\"ds-num\">-5.4% better</td></tr></tbody></table>",
      "css": ".ds-table{border-collapse:collapse;width:100%;background:var(--c-surface);font-size:0.8rem}.ds-table th{height:32px;padding:7px 10px;background:var(--c-bg-inset);color:var(--c-text-muted);font-size:0.68rem;font-weight:750;letter-spacing:0.04em;text-transform:uppercase;text-align:left}.ds-table td{padding:7px 10px;border-top:1px solid var(--c-border-muted);color:var(--c-text)}.ds-table tr:hover td{background:var(--c-row-hover)}.ds-num{font-family:SFMono-Regular,Consolas,'Liberation Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Sidebar links with an active wash and edge marker.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link ds-active\" href=\"#\">Runs</a><a class=\"ds-nav-link\" href=\"#\">Benchmarks</a><a class=\"ds-nav-link\" href=\"#\">Compare</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:200px;padding:8px;background:var(--c-shell)}.ds-nav-link{position:relative;height:34px;display:flex;align-items:center;padding:0 10px;border-radius:4px;color:var(--c-text-muted);text-decoration:none;font-size:13px}.ds-nav-link:hover{background:var(--c-surface-hover);color:var(--c-text)}.ds-nav-link:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}.ds-active{background:color-mix(in srgb,var(--c-accent) 11%,transparent);color:var(--c-text)}.ds-active::before{content:'';position:absolute;left:-8px;top:7px;bottom:7px;width:3px;border-radius:0 3px 3px 0;background:var(--c-accent)}"
    },
    {
      "name": "Measurement Value",
      "kind": "custom",
      "description": "Monospace value; hover shows the exact number, click copies it.",
      "html": "<button class=\"ds-measure\" title=\"0.00007772 s — click to copy the exact number\">77.72 µs</button>",
      "css": ".ds-measure{padding:0;border:0;background:transparent;color:var(--c-text);cursor:pointer;font-family:SFMono-Regular,Consolas,'Liberation Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;font-size:0.8rem;text-decoration:underline dotted color-mix(in srgb,currentColor 45%,transparent);text-underline-offset:3px}.ds-measure:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Lab Notebook",
    "overview": "BenchDB reads like a careful record of measurements. Every page is a dense, annotated sheet: the verdict first, then the numbers that justify it, each traceable to the run, commit, and machine that produced it. Nothing is there for decoration. A quiet page means nothing needs attention.\n\nThe mood is calm, dense, and exact. Cool grey paper carries white panels with hairline rules. Body text is small (13px) so tables and charts fit on one screen, and every number is set in a monospace face with tabular figures so columns line up and values can be compared at a glance. One blue accent marks what can be clicked or is selected; the remaining color belongs to status and to the data itself.\n\nControls are compact and tactile: small, but clearly clickable, with visible borders and a firm hover response. Surfaces stay flat at rest; only things that float above the page, such as menus, popovers, and the mobile drawer, lift with a real shadow.",
    "keyCharacteristics": [
      "Dense 13px body with monospace tabular numbers.",
      "Cool grey ground, white panels, hairline borders, near-flat surfaces.",
      "One accent (Instrument Blue) for interaction; status colors for verdicts.",
      "Verdict, then evidence: summaries lead, exact values are one click away.",
      "Light and dark themes share every token name."
    ],
    "rules": [
      {
        "name": "The Verdict Color Rule",
        "body": "Red and green mean regressed and improved, and nothing else. Never use them for a machine series, a decoration, or a brand moment.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "Instrument Blue is the only non-status hue in the interface chrome. A page has at most one filled blue button.",
        "section": "colors"
      },
      {
        "name": "The AA Floor Rule",
        "body": "Text must meet WCAG 2.2 AA contrast (4.5:1 for normal text) in both themes. Known gaps in the current light theme: Ink Faint on white (3.4:1), Improved Green text (3.8:1), white text on filled amber status pills (3.2:1), red on its wash (4.4:1), and slate on its wash (4.3:1). In the dark theme, Ink Faint on a panel is 3.7:1. Do not add new uses of these pairs for text that must be read; fix them when touching the component.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every measured number uses the numeric face with tabular figures, including inside sentences such as \"77.72 µs vs 77.67 µs\".",
        "section": "typography"
      },
      {
        "name": "The Small Caps Budget Rule",
        "body": "Uppercase is for table headers, stacked-row labels, and the eyebrow. Headings and buttons stay in sentence case.",
        "section": "typography"
      },
      {
        "name": "The Summary Line Rule",
        "body": "Counts live in one quiet inline line under the header, separated by middle dots, with only signal-bearing counts (errors, regressions) emphasized. No big-number stat cards.",
        "section": "layout"
      },
      {
        "name": "The Earned Column Rule",
        "body": "A table column or summary count appears only when it carries information for the rows on screen. Zero counts and columns of repeated values are hidden.",
        "section": "layout"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Nothing on the page plane casts a shadow larger than a hairline. Lift is reserved for surfaces that float above it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the verdict first and link it to the measurements behind it.",
      "Do set every measured number in the numeric face with tabular figures, and render displayed measurements with the copyable measurement value.",
      "Do keep the page plane flat; use hairline borders and tonal steps for structure.",
      "Do pair every status color with its status word.",
      "Do hide columns and counts that carry no information for the rows on screen."
    ],
    "donts": [
      "Don't use red or green for anything but regressed and improved, and don't use them for machine series.",
      "Don't add big-number stat cards; counts belong in the summary line.",
      "Don't add helper text that repeats a heading or label.",
      "Don't introduce a second accent hue or more than one filled primary button on a page."
    ]
  }
}
