{{- /*
Overrides oapi-codegen-dd's "envelopeResponse" block from
client-with-response.tmpl (Apache-2.0, see LICENSE in this directory).

The upstream block decodes a `default` response body before checking whether
the status is 2xx. Huma documents `default` as the problem+json error model, so
for the browser-redirect operations (302 + default) a redirect-following client
that lands on a 200 HTML page failed with a ResponseDecodeError. This version
returns success for a 2xx before decoding the error body.
*/ -}}
{{- define "envelopeResponse" }}
{{- $op := .op }}
{{- $rcd := .rcd }}
        {{- if and $rcd.IsSuccess $rcd.IsDefault }}
        if resp.StatusCode/100 == 2 {
            return out, nil
        }
        {{- end }}
        {{- template "decodeBody" (dict "rcd" $rcd "alias" ($op.Response.LegacyBodyField $rcd)) }}
        {{- if gt (len $rcd.Headers) 0 }}
        out.Headers{{$rcd.StatusName}} = &{{ $op.HeaderTypeName $rcd }}{
            {{- range $hName, $hSchema := $rcd.Headers }}
            {{ genTypeName $hName }}: resp.Headers.Get("{{ escapeGoString $hName }}"),
            {{- end }}
        }
        {{- if $op.Response.HasLegacyHeaders $rcd }}
        out.Headers{{$rcd.StatusCode}} = out.Headers{{$rcd.StatusName}}
        {{- end }}
        {{- end }}
        {{- if and $rcd.IsSuccess (not $rcd.IsDefault) }}
        return out, nil
        {{- else }}
        return out, runtime.NewClientAPIError(fmt.Errorf("API error (status %d)", resp.StatusCode), runtime.WithStatusCode(resp.StatusCode))
        {{- end }}
{{- end }}
