FROM --platform=$BUILDPLATFORM oven/bun:1.3.14 AS web-build

WORKDIR /src/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
RUN bun run build

FROM golang:1.27.3-bookworm AS go-build

WORKDIR /src
# "|" falls back to the source repo on any proxy error, including HTTP/2 stream resets mid-download.
ENV GOPROXY="https://proxy.golang.org|direct"
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-build /src/web/dist ./web/dist
ARG TARGETOS
ARG TARGETARCH
# The build context excludes .git, so the commit comes in as a build argument.
ARG BENCHDB_REVISION=""
RUN CGO_ENABLED=1 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-X go.kenn.io/benchdb/internal/buildinfo.revision=${BENCHDB_REVISION}" \
    -o /out/benchdb ./cmd/benchdb
RUN scripts/install_duckdb_extensions.sh /out/duckdb/extensions

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -m 0700 -o 65532 -g 65532 /var/lib/benchdb

COPY --from=go-build /out/benchdb /usr/local/bin/benchdb
COPY --from=go-build /out/duckdb/extensions /usr/local/share/benchdb/duckdb/extensions
ENV BENCHDB_DATA_DIR=/var/lib/benchdb \
    BENCHDB_DUCKDB_EXTENSION_DIR=/usr/local/share/benchdb/duckdb/extensions
# Reuse a named volume at this path when replacing the container.
VOLUME ["/var/lib/benchdb"]
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/benchdb", "serve"]
