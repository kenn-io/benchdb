# PgBouncer fixture for archive coordination tests. It is a test dependency
# only; nothing here ships in BenchDB images.
#
# Base: alpine 3.24.2, index digest read from Docker Hub on 2026-10-23.
# PgBouncer 1.26.1 (released 2026-10-14, fixes CVE-2026-107348, -107349, and
# -107350). The checksum is the official .sha256 published at
# https://www.pgbouncer.org/downloads/files/1.26.1/ and matches a local
# sha256sum of the downloaded tarball.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS build

ARG PGBOUNCER_VERSION=1.26.1
ARG PGBOUNCER_SHA256=00886a2994b4844cd37110970df777772cfc42a74c400522c82fba509a3f42d9

# The binary target avoids the man pages, which would need pandoc.
RUN apk add --no-cache build-base curl libevent-dev openssl-dev
WORKDIR /src
RUN curl -fsSL -o pgbouncer.tar.gz \
      "https://www.pgbouncer.org/downloads/files/${PGBOUNCER_VERSION}/pgbouncer-${PGBOUNCER_VERSION}.tar.gz" \
    && echo "${PGBOUNCER_SHA256}  pgbouncer.tar.gz" | sha256sum -c - \
    && tar -xzf pgbouncer.tar.gz --strip-components=1 \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" pgbouncer \
    && install -m 0755 pgbouncer /usr/local/bin/pgbouncer

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache libevent libssl3 \
    && adduser -S -H -h /nonexistent pgbouncer
COPY --from=build /usr/local/bin/pgbouncer /usr/local/bin/pgbouncer
USER pgbouncer
EXPOSE 6432
ENTRYPOINT ["pgbouncer", "/etc/pgbouncer/pgbouncer.ini"]
